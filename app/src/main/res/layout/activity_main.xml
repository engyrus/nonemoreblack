<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blackout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pure_black"
    android:elevation="0dp"
    android:keepScreenOn="true">

    <LinearLayout
        android:id="@+id/logo_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/logo_stack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/logo_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.33"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nmb_logo" />

            <ImageView
                android:id="@+id/umlauts_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.33"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nmb_umlauts" />

        </FrameLayout>

        <TextView
            android:id="@+id/logo_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.33"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="none more black"
            android:textColor="#E0E0E0" />

    </LinearLayout>

    <TextView
        android:id="@+id/footer_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:alpha="0.33"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="github.com/engyrus"
        android:textColor="#E0E0E0" />

</FrameLayout>
